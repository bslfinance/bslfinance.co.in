---
import PageLayout from '../layouts/PageLayout.astro';
import companyInfo from '../data/companyInfo.json';
import {
  Briefcase,
  ShieldCheck,
  CheckCircle2,
  Mail,
  GraduationCap,
  Users,
  ArrowRight,
  AlertCircle
} from '@lucide/astro';
---

<PageLayout
  title="Careers at BSL Nidhi Limited | Join Our Team"
  description="Explore career opportunities at BSL Nidhi Limited. We are committed to hiring, developing, motivating, and retaining the best financial talent."
>
  <!-- Header Banner -->
  <section class="bg-gradient-to-b from-bsl-darkgreen to-emerald-950 text-white py-14 px-4 sm:px-6 lg:px-8 border-b border-emerald-800">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-900/80 text-emerald-200 border border-emerald-700">
          <Briefcase class="w-3.5 h-3.5 text-bsl-gold" />
          Join BSL Nidhi
        </span>
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-amber-400 text-slate-950">
          Empowering Talent
        </span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-white mb-3 tracking-tight">
        Career with Us
      </h1>
      <p class="text-emerald-100/90 text-base sm:text-lg max-w-3xl leading-relaxed">
        A journey of growth, learning, and success. We are committed to hiring, developing, motivating, and retaining the best talent in financial services.
      </p>
    </div>
  </section>

  <!-- Body Content -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Left Content (8 Cols) -->
      <div class="lg:col-span-8 space-y-8">
        
        <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-4 text-slate-700 leading-relaxed text-sm sm:text-base">
          <h2 class="text-2xl font-bold text-bsl-navy mb-2">
            Build Your Career in Inclusive Finance
          </h2>
          <p>
            Whether you are a fresh graduate embarking on your professional career or an experienced professional looking to accelerate your growth, BSL Nidhi provides an inspiring platform to enrich your career.
          </p>
          <p>
            Join one of India's fast-growing Nidhi companies and thrive in an environment built around continuous learning, professional development, and value-driven performance.
          </p>
        </div>

        <!-- Why Work With Us -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm space-y-2">
            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-bsl-green flex items-center justify-center mb-3">
              <GraduationCap class="w-5 h-5" />
            </div>
            <h4 class="font-bold text-slate-900 text-base">Continuous Learning</h4>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Structured training programs on statutory banking compliance, member relationship management, and financial product structuring.
            </p>
          </div>

          <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm space-y-2">
            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-bsl-green flex items-center justify-center mb-3">
              <Users class="w-5 h-5" />
            </div>
            <h4 class="font-bold text-slate-900 text-base">Transparent Culture</h4>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              An open, merit-driven workplace that values integrity, mutual respect, and member service excellence above all else.
            </p>
          </div>
        </div>

        <!-- Recruitment Fraud Advisory -->
        <div class="bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-xl space-y-2">
          <div class="flex items-center gap-2 font-bold text-amber-950 text-sm">
            <AlertCircle class="w-5 h-5 text-amber-600" />
            <span>Official Recruitment Advisory</span>
          </div>
          <p class="text-xs sm:text-sm text-amber-900 leading-relaxed">
            BSL Nidhi Limited does not charge any fee or deposit from candidates during any stage of recruitment. Any communication requesting monetary consideration on behalf of BSL Nidhi is fraudulent.
          </p>
        </div>

      </div>

      <!-- Right Sidebar (4 Cols) -->
      <div class="lg:col-span-4 space-y-6">
        <div class="bg-gradient-to-br from-bsl-darkgreen to-emerald-950 text-white rounded-2xl p-6 shadow-md border border-emerald-800 space-y-4">
          <h3 class="text-lg font-bold text-white">Submit Your Resume</h3>
          <p class="text-xs text-emerald-200 leading-relaxed">
            Send your updated CV and cover letter directly to our human resources department.
          </p>
          <div class="pt-2">
            <a
              href={`mailto:${companyInfo.email}?subject=Application for Career Opportunity at BSL Nidhi`}
              class="w-full inline-flex items-center justify-center gap-2 py-3 rounded-xl font-bold text-sm text-bsl-darkgreen bg-white hover:bg-emerald-50 transition-colors shadow"
            >
              <Mail class="w-4 h-4 text-bsl-green" />
              <span>Email Your Resume</span>
            </a>
          </div>
        </div>

        <div class="bg-white border border-slate-200 rounded-2xl p-6 space-y-3 shadow-sm">
          <h4 class="font-bold text-sm text-slate-900">Branch Inquiries</h4>
          <p class="text-xs text-slate-500">
            For internship programs or field executive opportunities, you may also reach out via our general inquiry channel.
          </p>
          <a href="/contact" class="inline-flex items-center gap-1 text-xs font-bold text-bsl-green hover:underline">
            <span>Contact Us Page</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>

    </div>
  </div>
</PageLayout>
