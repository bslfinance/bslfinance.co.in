---
import LegalDocumentLayout from '../components/legal/LegalDocumentLayout.astro';
import companyInfo from '../data/companyInfo.json';
import { ShieldCheck, Lock, Cookie, EyeOff, Server } from '@lucide/astro';
---

<LegalDocumentLayout
  title="Privacy Policy"
  subtitle="We value and protect your privacy. Our protocols for data confidentiality, encryption, and statutory disclosures."
  currentSlug="privacy-policy"
>
  <div class="space-y-8 text-slate-700 leading-relaxed text-sm sm:text-base">
    
    <div class="bg-emerald-50 border-l-4 border-bsl-green p-5 rounded-r-xl">
      <div class="h4 text-bsl-green font-bold text-lg mb-1 flex items-center gap-2">
        <ShieldCheck class="w-5 h-5" />
        We Value and Protect Your Privacy
      </div>
      <p class="text-xs sm:text-sm text-emerald-900 leading-relaxed">
        BSL Nidhi Limited is strongly committed to protecting customer privacy and has taken all reasonable security measures to safeguard information transmission.
      </p>
    </div>

    <section class="space-y-4">
      <h3 class="text-xl font-bold text-bsl-navy flex items-center gap-2 border-b pb-2 border-slate-100">
        <Lock class="w-5 h-5 text-bsl-green" />
        Collection and Protection of Information
      </h3>
      <p>
        In the course of using this website, mobile applications, or availing the products and services via online forms, BSL Nidhi Ltd. may become privy to personal information of its customers, including information that is of a confidential nature.
      </p>
      <p>
        BSL Nidhi Ltd. is strongly committed to protecting customer privacy and has taken all reasonable security measures to safeguard information transmission.
      </p>
      <p>
        BSL Nidhi Ltd. uses industry-standard encryption protocols for transmitting sensitive data. Customers are advised to maintain complex passwords and refrain from sharing credentials with third parties.
      </p>
    </section>

    <section class="space-y-4">
      <h3 class="text-xl font-bold text-bsl-navy flex items-center gap-2 border-b pb-2 border-slate-100">
        <EyeOff class="w-5 h-5 text-bsl-green" />
        Disclosure of Information
      </h3>
      <p>
        BSL Nidhi Ltd. undertakes not to disclose confidential information provided by customers unless required to:
      </p>
      <ul class="list-disc pl-6 space-y-2 text-slate-700">
        <li>Conform to statutory legal requirements or comply with lawful governmental process;</li>
        <li>Protect and defend BSL Nidhi Ltd.'s rights, interests, or property;</li>
        <li>Enforce contractual terms and conditions of products or services; or</li>
        <li>Protect the interests of BSL Nidhi Ltd., its affiliates, or members.</li>
      </ul>
    </section>

    <section class="space-y-4">
      <h3 class="text-xl font-bold text-bsl-navy flex items-center gap-2 border-b pb-2 border-slate-100">
        <Cookie class="w-5 h-5 text-bsl-green" />
        Cookie Policy
      </h3>
      <p>
        Our website may use standard analytical cookies to analyze aggregated, non-personally identifiable traffic patterns and optimize the browsing experience. Users can manage or disable cookies via their browser preferences.
      </p>
    </section>

    <section class="space-y-4 pt-4 border-t border-slate-100 text-xs text-slate-500">
      <div class="flex items-center gap-2 font-semibold text-slate-700">
        <Server class="w-4 h-4 text-bsl-green" />
        <span>Data Governance & Inquiries</span>
      </div>
      <p>
        For inquiries regarding data privacy or to update personal KYC records, members may contact our compliance team directly at <a href={`mailto:${companyInfo.email}`} class="text-bsl-green hover:underline font-medium">{companyInfo.email}</a> or visit the registered branch during working hours.
      </p>
    </section>

  </div>
</LegalDocumentLayout>
