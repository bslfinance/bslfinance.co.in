---
import LegalDocumentLayout from '../../components/legal/LegalDocumentLayout.astro';
import companyInfo from '../../data/companyInfo.json';
import { Download, ExternalLink, FileCheck, Shield, Award, Landmark } from '@lucide/astro';
---

<LegalDocumentLayout
  title="Legal & Regulatory Certification"
  subtitle="BSL Nidhi Limited is fully incorporated under the Companies Act 2013 and regulated by the Ministry of Corporate Affairs (MCA), Government of India."
  documentNumber={"CIN: " + companyInfo.cin}
  currentSlug="legal"
>
  <div class="space-y-10">
    
    <!-- Introduction & Authority Statement -->
    <div class="prose max-w-none text-slate-700">
      <h2 class="text-2xl font-bold text-bsl-navy flex items-center gap-2 border-b pb-3 border-slate-100">
        <Landmark class="w-6 h-6 text-bsl-green" />
        Statutory Incorporation & Recognition
      </h2>
      <p class="leading-relaxed mt-4">
        <strong>BSL Nidhi Limited</strong> (CIN: <span class="font-mono font-bold text-bsl-green">{companyInfo.cin}</span>) is a mutual benefit company officially incorporated under <strong>Section 406 of the Companies Act, 2013</strong>. The Company is subject to the provisions of the <strong>Nidhi Rules, 2014</strong>, as amended by the Central Government, and operates under the direct regulatory oversight of the <strong>Ministry of Corporate Affairs (MCA)</strong>, Government of India.
      </p>
      <p class="leading-relaxed">
        The primary statutory object of the company is to foster the habits of thrift, discipline, and regular savings amongst its enrolled members, and to receive deposits from, and to lend to, its members only, for their mutual benefit.
      </p>
    </div>

    <!-- Official Registration Details Summary Table -->
    <div class="rounded-xl border border-slate-200 overflow-hidden bg-slate-50/50">
      <div class="bg-bsl-green text-white px-5 py-3 font-bold text-sm flex items-center gap-2">
        <Award class="w-4 h-4 text-bsl-gold" />
        Official Corporate Registry Details
      </div>
      <dl class="divide-y divide-slate-200 text-sm">
        <div class="grid grid-cols-1 sm:grid-cols-3 p-4 gap-1">
          <dt class="font-medium text-slate-500">Corporate Identity Number (CIN)</dt>
          <dd class="sm:col-span-2 font-mono font-bold text-slate-900">{companyInfo.cin}</dd>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 p-4 gap-1">
          <dt class="font-medium text-slate-500">Company Name</dt>
          <dd class="sm:col-span-2 font-bold text-slate-900">{companyInfo.name}</dd>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 p-4 gap-1">
          <dt class="font-medium text-slate-500">Company Category / Class</dt>
          <dd class="sm:col-span-2 text-slate-700">Company limited by Shares / Public Indian Non-Government Company (Nidhi Company)</dd>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 p-4 gap-1">
          <dt class="font-medium text-slate-500">Statutory Governing Authority</dt>
          <dd class="sm:col-span-2 text-slate-700">{companyInfo.regulatoryAuthority}</dd>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 p-4 gap-1">
          <dt class="font-medium text-slate-500">Statutory Act & Rules</dt>
          <dd class="sm:col-span-2 text-slate-700">Section 406, Companies Act 2013 & Nidhi Rules, 2014</dd>
        </div>
      </dl>
      <div class="p-4 bg-emerald-50 border-t border-emerald-100 flex items-center justify-between flex-wrap gap-2 text-xs">
        <span class="text-emerald-800 font-medium">Verify company authenticity on the official Ministry of Corporate Affairs portal:</span>
        <a
          href={companyInfo.mcaCinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 font-bold text-bsl-green hover:text-bsl-darkgreen"
        >
          <span>Verify CIN on MCA Portal</span>
          <ExternalLink class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>

    <!-- Official Documents Grid: PAN and COI -->
    <div>
      <h3 class="text-xl font-bold text-bsl-navy mb-4 flex items-center gap-2">
        <FileCheck class="w-5 h-5 text-bsl-green" />
        Official Statutory Documents (Direct Verification)
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Document 1: Certificate of Incorporation (COI) -->
        <div class="rounded-2xl border border-slate-200 overflow-hidden shadow-sm bg-white flex flex-col justify-between">
          <div class="p-6">
            <div class="flex items-center justify-between mb-4">
              <span class="p-2.5 rounded-xl bg-emerald-100 text-bsl-green">
                <Award class="w-6 h-6" />
              </span>
              <span class="text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-slate-100 text-slate-600">
                MCA Certified
              </span>
            </div>
            <h4 class="text-lg font-bold text-slate-900 mb-1">
              Certificate of Incorporation (COI)
            </h4>
            <p class="text-xs text-slate-500 mb-4 leading-relaxed">
              Official registration certificate issued by the Registrar of Companies (ROC), Ministry of Corporate Affairs, Government of India.
            </p>
            <div class="text-xs text-slate-600 bg-slate-50 rounded-lg p-3 font-mono">
              CIN: {companyInfo.cin}
            </div>
          </div>
          <div class="bg-slate-50 p-4 border-t border-slate-100 flex items-center justify-between gap-2">
            <a
              href="/documents/COI.PDF"
              target="_blank"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-bsl-green hover:underline"
            >
              <ExternalLink class="w-3.5 h-3.5" />
              <span>View Fullscreen</span>
            </a>
            <a
              href="/documents/COI.PDF"
              download="BSL_Nidhi_COI.pdf"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold text-white bg-bsl-green hover:bg-bsl-darkgreen transition-colors"
            >
              <Download class="w-3.5 h-3.5" />
              <span>Download PDF</span>
            </a>
          </div>
        </div>

        <!-- Document 2: Company PAN Card -->
        <div class="rounded-2xl border border-slate-200 overflow-hidden shadow-sm bg-white flex flex-col justify-between">
          <div class="p-6">
            <div class="flex items-center justify-between mb-4">
              <span class="p-2.5 rounded-xl bg-amber-100 text-amber-800">
                <Shield class="w-6 h-6" />
              </span>
              <span class="text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-slate-100 text-slate-600">
                IT Dept Govt of India
              </span>
            </div>
            <h4 class="text-lg font-bold text-slate-900 mb-1">
              Company PAN Card
            </h4>
            <p class="text-xs text-slate-500 mb-4 leading-relaxed">
              Permanent Account Number (PAN) issued to BSL Nidhi Limited by the Income Tax Department, Government of India.
            </p>
            <div class="text-xs text-slate-600 bg-slate-50 rounded-lg p-3 font-mono">
              Entity: {companyInfo.name}
            </div>
          </div>
          <div class="bg-slate-50 p-4 border-t border-slate-100 flex items-center justify-between gap-2">
            <a
              href="/documents/PAN.pdf"
              target="_blank"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-bsl-green hover:underline"
            >
              <ExternalLink class="w-3.5 h-3.5" />
              <span>View Fullscreen</span>
            </a>
            <a
              href="/documents/PAN.pdf"
              download="BSL_Nidhi_PAN.pdf"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold text-white bg-bsl-green hover:bg-bsl-darkgreen transition-colors"
            >
              <Download class="w-3.5 h-3.5" />
              <span>Download PDF</span>
            </a>
          </div>
        </div>

      </div>
    </div>

    <!-- Mandatory Statutory Disclosure -->
    <div class="p-5 rounded-xl bg-amber-50/70 border border-amber-200/80 text-xs text-amber-900 leading-relaxed space-y-2">
      <div class="font-bold text-sm text-amber-950 flex items-center gap-1.5">
        <Shield class="w-4 h-4 text-amber-700" />
        Statutory Declaration under Nidhi Rules, 2014
      </div>
      <p>
        BSL Nidhi Limited explicitly clarifies that deposits accepted by the company are not insured by the Deposit Insurance and Credit Guarantee Corporation (DICGC). The financial transactions and operations of the company are conducted solely among enrolled shareholder members as permitted by Section 406 of the Companies Act, 2013 and Nidhi Rules, 2014.
      </p>
    </div>

  </div>
</LegalDocumentLayout>
