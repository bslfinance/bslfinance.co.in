---
import PageLayout from '../../layouts/PageLayout.astro';
import rates from '../../data/rates.json';
import companyInfo from '../../data/companyInfo.json';
import {
  FileText,
  ShieldCheck,
  CheckCircle2,
  HelpCircle,
  ArrowRight,
  TrendingUp,
  Percent
} from '@lucide/astro';

const lad = rates.loans.loanAgainstDeposit;
---

<PageLayout
  title="Loan Against Deposit (FD / RD) | BSL Nidhi Limited"
  description="Avail up to 90% loan against your Fixed or Recurring Deposit at BSL Nidhi Limited without breaking your investment or losing interest."
>
  <!-- Header Banner -->
  <section class="bg-gradient-to-b from-emerald-950 via-slate-900 to-bsl-navy text-white py-14 px-4 sm:px-6 lg:px-8 border-b border-emerald-900/60">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-900/80 text-emerald-200 border border-emerald-700">
          <ShieldCheck class="w-3.5 h-3.5 text-bsl-gold" />
          No Need to Break Your Deposit
        </span>
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-amber-400 text-slate-950">
          {lad.maxAdvance}
        </span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-white mb-3 tracking-tight">
        {lad.title}
      </h1>
      <p class="text-emerald-100/90 text-base sm:text-lg max-w-3xl leading-relaxed">
        {lad.shortDescription}
      </p>

      <div class="flex flex-wrap items-center gap-6 mt-6 pt-4 border-t border-emerald-900/60 text-xs sm:text-sm text-emerald-200">
        <div>Interest Rate: <strong class="text-white">{lad.rateDisplay}</strong></div>
        <span>•</span>
        <div>Maximum Advance: <strong class="text-white">{lad.maxAdvance}</strong></div>
        <span>•</span>
        <div>Disbursal: <strong class="text-white">{lad.processingTime}</strong></div>
      </div>
    </div>
  </section>

  <!-- Body Content -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Left Content (8 Cols) -->
      <div class="lg:col-span-8 space-y-10">
        
        <!-- Highlights -->
        <section class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-4">
          <h2 class="text-2xl font-bold text-bsl-navy flex items-center gap-2">
            <Percent class="w-6 h-6 text-bsl-green" />
            Why Choose Loan Against Deposit?
          </h2>
          <p class="text-sm text-slate-600 leading-relaxed">
            Breaking a fixed deposit prematurely results in lower interest rates and penal deductions. A Loan Against Deposit provides instant liquidity while keeping your original deposit certificate active and earning full compounding interest.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            {lad.highlights.map((highlight) => (
              <div class="flex items-start gap-3 text-sm text-slate-700">
                <CheckCircle2 class="w-5 h-5 text-bsl-green shrink-0 mt-0.5" />
                <span>{highlight}</span>
              </div>
            ))}
            <div class="flex items-start gap-3 text-sm text-slate-700">
              <CheckCircle2 class="w-5 h-5 text-bsl-green shrink-0 mt-0.5" />
              <span>Available for both Fixed Deposit (FD) and Recurring Deposit (RD) accounts.</span>
            </div>
            <div class="flex items-start gap-3 text-sm text-slate-700">
              <CheckCircle2 class="w-5 h-5 text-bsl-green shrink-0 mt-0.5" />
              <span>Flexible repayment options through lump-sum settlement or monthly installments.</span>
            </div>
          </div>
        </section>

        <!-- Terms of Loan -->
        <section class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-4">
          <h3 class="text-xl font-bold text-bsl-navy flex items-center gap-2">
            <FileText class="w-5 h-5 text-bsl-green" />
            Terms & Guidelines under Nidhi Rules
          </h3>
          <ul class="space-y-2 text-sm text-slate-600 list-disc pl-5">
            <li>Loan facility is available exclusively to the primary holder of the active deposit.</li>
            <li>Original deposit receipt/certificate is pledged with BSL Nidhi Limited during the loan period.</li>
            <li>Interest rate charged is only 2.00% above the underlying deposit interest rate.</li>
            <li>The tenure of the loan will not exceed the maturity date of the pledged deposit.</li>
            <li>Upon full repayment of loan principal and interest, the original deposit receipt is released.</li>
          </ul>
        </section>

      </div>

      <!-- Right Sidebar (4 Cols) -->
      <div class="lg:col-span-4 space-y-6">
        <div class="bg-gradient-to-br from-bsl-darkgreen to-emerald-950 text-white rounded-2xl p-6 shadow-md border border-emerald-800 space-y-4">
          <h3 class="text-lg font-bold text-white">Apply for Loan on Deposit</h3>
          <p class="text-xs text-emerald-200 leading-relaxed">
            Carry your active FD/RD receipt to our branch or connect with your relationship manager for instant disbursal.
          </p>
          <div class="pt-2 space-y-3">
            <a
              href="/contact"
              class="w-full inline-flex items-center justify-center gap-2 py-3 rounded-xl font-bold text-sm text-bsl-darkgreen bg-white hover:bg-emerald-50 transition-colors shadow"
            >
              <span>Submit Loan Inquiry</span>
              <ArrowRight class="w-4 h-4" />
            </a>
            <a
              href={`tel:${companyInfo.phoneRaw}`}
              class="w-full inline-flex items-center justify-center gap-2 py-2.5 rounded-xl font-semibold text-xs text-emerald-100 bg-emerald-900/60 hover:bg-emerald-900 border border-emerald-700/60 transition-colors"
            >
              <span>Call Helpline: {companyInfo.phone}</span>
            </a>
          </div>
        </div>

        <div class="bg-white border border-slate-200 rounded-2xl p-6 space-y-3 shadow-sm">
          <h4 class="font-bold text-sm text-slate-900 flex items-center gap-2">
            <HelpCircle class="w-4 h-4 text-bsl-green" />
            Deposit Loan FAQs
          </h4>
          <p class="text-xs text-slate-500">
            Learn more about margin requirements, interest adjustment at maturity, and joint accounts.
          </p>
          <a href="/faqs" class="inline-flex items-center gap-1 text-xs font-bold text-bsl-green hover:underline">
            <span>View All FAQs</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>

    </div>
  </div>
</PageLayout>
