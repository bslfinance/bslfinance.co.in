---
import PageLayout from '../../layouts/PageLayout.astro';
import rates from '../../data/rates.json';
import companyInfo from '../../data/companyInfo.json';
import {
  Home,
  ShieldCheck,
  CheckCircle2,
  FileText,
  HelpCircle,
  ArrowRight,
  Building
} from '@lucide/astro';

const lap = rates.loans.loanAgainstProperty;
---

<PageLayout
  title="Loan Against Property | Business & Personal Loans | BSL Nidhi Limited"
  description="Leverage residential or commercial real estate equity for business expansion with BSL Nidhi Limited Loan Against Property. Competitive interest rates from 14.00% p.a."
>
  <!-- Header Banner -->
  <section class="bg-gradient-to-b from-slate-900 to-bsl-navy text-white py-14 px-4 sm:px-6 lg:px-8 border-b border-slate-800">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-900/80 text-emerald-200 border border-emerald-700">
          <ShieldCheck class="w-3.5 h-3.5 text-bsl-gold" />
          Higher Credit Quantum
        </span>
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-amber-400 text-slate-950">
          Rates {lap.rateDisplay}
        </span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-white mb-3 tracking-tight">
        {lap.title}
      </h1>
      <p class="text-slate-300 text-base sm:text-lg max-w-3xl leading-relaxed">
        {lap.shortDescription}
      </p>

      <div class="flex flex-wrap items-center gap-6 mt-6 pt-4 border-t border-slate-800 text-xs sm:text-sm text-slate-300">
        <div>Starting Interest: <strong class="text-white">{lap.rateDisplay}</strong></div>
        <span>•</span>
        <div>Maximum Tenure: <strong class="text-white">{lap.maxTenure}</strong></div>
        <span>•</span>
        <div>Collateral: <strong class="text-white">Residential / Commercial Property</strong></div>
      </div>
    </div>
  </section>

  <!-- Body Content -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Left Content (8 Cols) -->
      <div class="lg:col-span-8 space-y-10">
        
        <!-- Highlights -->
        <section class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-4">
          <h2 class="text-2xl font-bold text-bsl-navy flex items-center gap-2">
            <Building class="w-6 h-6 text-bsl-green" />
            Empower Your Business Growth
          </h2>
          <p class="text-sm text-slate-600 leading-relaxed">
            Unlock the dormant equity in your residential or commercial property to fund business expansion, working capital, inventory purchases, or debt consolidation with structured repayment terms.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            {lap.highlights.map((highlight) => (
              <div class="flex items-start gap-3 text-sm text-slate-700">
                <CheckCircle2 class="w-5 h-5 text-bsl-green shrink-0 mt-0.5" />
                <span>{highlight}</span>
              </div>
            ))}
            <div class="flex items-start gap-3 text-sm text-slate-700">
              <CheckCircle2 class="w-5 h-5 text-bsl-green shrink-0 mt-0.5" />
              <span>Transparent legal evaluation and fair property valuation.</span>
            </div>
            <div class="flex items-start gap-3 text-sm text-slate-700">
              <CheckCircle2 class="w-5 h-5 text-bsl-green shrink-0 mt-0.5" />
              <span>Dedicated relationship manager to guide you through property documentation.</span>
            </div>
          </div>
        </section>

        <!-- Terms of Loan -->
        <section class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-4">
          <h3 class="text-xl font-bold text-bsl-navy flex items-center gap-2">
            <FileText class="w-5 h-5 text-bsl-green" />
            Terms & Eligibility Criteria
          </h3>
          <ul class="space-y-2 text-sm text-slate-600 list-disc pl-5">
            <li>Membership in BSL Nidhi Limited is mandatory for all applicants and co-owners.</li>
            <li>Applicant must possess clear, marketable, and unencumbered title deeds to the property.</li>
            <li>Property inspection and valuation by authorized valuers of the company.</li>
            <li>Maximum loan quantum and repayment terms governed by Nidhi Rules, 2014.</li>
            <li>Equitable mortgage or registered mortgage executed in favor of BSL Nidhi Limited.</li>
          </ul>
        </section>

      </div>

      <!-- Right Sidebar (4 Cols) -->
      <div class="lg:col-span-4 space-y-6">
        <div class="bg-gradient-to-br from-bsl-darkgreen to-emerald-950 text-white rounded-2xl p-6 shadow-md border border-emerald-800 space-y-4">
          <h3 class="text-lg font-bold text-white">Apply for Property Loan</h3>
          <p class="text-xs text-emerald-200 leading-relaxed">
            Consult our credit officers for an initial assessment of your property loan eligibility.
          </p>
          <div class="pt-2 space-y-3">
            <a
              href="/contact"
              class="w-full inline-flex items-center justify-center gap-2 py-3 rounded-xl font-bold text-sm text-bsl-darkgreen bg-white hover:bg-emerald-50 transition-colors shadow"
            >
              <span>Request Property Consultation</span>
              <ArrowRight class="w-4 h-4" />
            </a>
            <a
              href={`tel:${companyInfo.phoneRaw}`}
              class="w-full inline-flex items-center justify-center gap-2 py-2.5 rounded-xl font-semibold text-xs text-emerald-100 bg-emerald-900/60 hover:bg-emerald-900 border border-emerald-700/60 transition-colors"
            >
              <span>Call Helpline: {companyInfo.phone}</span>
            </a>
          </div>
        </div>

        <div class="bg-white border border-slate-200 rounded-2xl p-6 space-y-3 shadow-sm">
          <h4 class="font-bold text-sm text-slate-900 flex items-center gap-2">
            <HelpCircle class="w-4 h-4 text-bsl-green" />
            Property Loan FAQs
          </h4>
          <p class="text-xs text-slate-500">
            Learn more about title searches, valuation procedures, and pre-closure terms.
          </p>
          <a href="/faqs" class="inline-flex items-center gap-1 text-xs font-bold text-bsl-green hover:underline">
            <span>View All FAQs</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>

    </div>
  </div>
</PageLayout>
