---
import { Sparkles, Info } from '@lucide/astro';

interface RateSlab {
  id?: string;
  tenure: string;
  tenureMonths?: number;
  rate: number;
  rateDisplay: string;
  enabled: boolean;
  badge?: string | null;
}

interface Props {
  slabs: RateSlab[];
  caption?: string;
  showSeniorCitizenNotice?: boolean;
}

const {
  slabs = [],
  caption = "Applicable Interest Rates",
  showSeniorCitizenNotice = true
} = Astro.props;

// Filter only enabled slabs (Core requirement: easy enable/disable toggle)
const activeSlabs = slabs.filter((slab) => slab.enabled === true);
---

<div class="my-6">
  {activeSlabs.length > 0 ? (
    <div class="overflow-hidden rounded-2xl border border-slate-200 shadow-sm bg-white">
      <div class="bg-gradient-to-r from-bsl-darkgreen via-bsl-green to-emerald-800 px-6 py-4 text-white flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
        <h4 class="font-bold text-base tracking-wide flex items-center gap-2">
          <span>{caption}</span>
        </h4>
        <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-950/60 text-emerald-200 border border-emerald-500/30">
          Governed by Nidhi Rules, 2014
        </span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50 text-slate-700 font-semibold border-b border-slate-200">
            <tr>
              <th scope="col" class="py-3.5 px-6">Tenure / Period</th>
              <th scope="col" class="py-3.5 px-6">Applicable Rate (p.a.)</th>
              <th scope="col" class="py-3.5 px-6 text-right">Remarks / Benefits</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {activeSlabs.map((slab, index) => {
              const isHighest = slab.badge === "Highest Return" || slab.badge === "Popular";
              return (
                <tr class={`transition-colors hover:bg-emerald-50/50 ${isHighest ? 'bg-amber-50/30' : index % 2 === 1 ? 'bg-slate-50/30' : ''}`}>
                  <td class="py-4 px-6 font-medium text-slate-900">
                    {slab.tenure}
                  </td>
                  <td class="py-4 px-6">
                    <span class={`inline-block font-extrabold text-base ${isHighest ? 'text-bsl-green text-lg' : 'text-slate-800'}`}>
                      {slab.rateDisplay}
                    </span>
                  </td>
                  <td class="py-4 px-6 text-right">
                    {slab.badge ? (
                      <span class="inline-flex items-center gap-1 text-xs font-bold px-2.5 py-1 rounded-full bg-amber-100 text-amber-900 border border-amber-300/60">
                        <Sparkles class="w-3 h-3 text-amber-700" />
                        {slab.badge}
                      </span>
                    ) : (
                      <span class="text-xs text-slate-400">Quarterly Compounding</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      {showSeniorCitizenNotice && (
        <div class="bg-slate-50/80 px-6 py-3 border-t border-slate-100 flex items-center gap-2 text-xs text-slate-600">
          <Info class="w-4 h-4 text-bsl-green shrink-0" />
          <span>
            <strong>Senior Citizens Notice:</strong> Eligible senior citizens (60+ years) may receive an additional 0.50% interest p.a. on qualifying tenures upon KYC verification.
          </span>
        </div>
      )}
    </div>
  ) : (
    <div class="rounded-xl p-8 bg-amber-50 border border-amber-200 text-center text-amber-900">
      <Info class="w-8 h-8 text-amber-600 mx-auto mb-2" />
      <h4 class="font-bold text-base mb-1">Interest Rate Revision in Progress</h4>
      <p class="text-sm text-amber-800">
        Interest rates are currently being updated in compliance with statutory directives. Please contact our branch directly for active scheme details.
      </p>
    </div>
  )}
</div>
