---
import { ArrowRight, CheckCircle2, Sparkles } from '@lucide/astro';

interface Props {
  title: string;
  rateBadge: string;
  description: string;
  highlights: string[];
  href: string;
  category?: 'deposit' | 'loan';
  badgeText?: string | null;
}

const {
  title,
  rateBadge,
  description,
  highlights = [],
  href,
  category = 'deposit',
  badgeText
} = Astro.props;

const isDeposit = category === 'deposit';
---

<div class="group relative bg-white rounded-2xl p-6 sm:p-7 border border-slate-200/90 shadow-soft hover:shadow-card-hover hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between overflow-hidden">
  
  <!-- Subtle top accent line -->
  <div class={`absolute top-0 left-0 right-0 h-1.5 ${isDeposit ? 'bg-gradient-to-r from-bsl-green to-emerald-400' : 'bg-gradient-to-r from-amber-500 to-bsl-gold'}`}></div>

  <div>
    <!-- Header with Badges -->
    <div class="flex items-start justify-between gap-3 mb-4">
      <span class={`inline-block text-xs font-extrabold px-3 py-1 rounded-full ${
        isDeposit
          ? 'bg-emerald-100 text-bsl-darkgreen'
          : 'bg-amber-100 text-amber-900'
      }`}>
        {rateBadge}
      </span>

      {badgeText && (
        <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-slate-900 text-bsl-gold tracking-wide">
          <Sparkles class="w-3 h-3 text-bsl-gold" />
          {badgeText}
        </span>
      )}
    </div>

    <!-- Title & Description -->
    <h3 class="text-xl font-bold text-bsl-navy group-hover:text-bsl-green transition-colors mb-2">
      {title}
    </h3>

    <p class="text-sm text-slate-600 leading-relaxed mb-5">
      {description}
    </p>

    <!-- Highlights checklist -->
    <ul class="space-y-2 mb-6">
      {highlights.slice(0, 3).map((item) => (
        <li class="flex items-start gap-2 text-xs sm:text-sm text-slate-700">
          <CheckCircle2 class={`w-4 h-4 mt-0.5 shrink-0 ${isDeposit ? 'text-bsl-green' : 'text-amber-600'}`} />
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Action Button -->
  <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
    <a
      href={href}
      class={`inline-flex items-center gap-2 text-sm font-bold transition-all group-hover:gap-3 ${
        isDeposit
          ? 'text-bsl-green group-hover:text-bsl-darkgreen'
          : 'text-amber-800 group-hover:text-amber-900'
      }`}
    >
      <span>Explore Scheme & Rates</span>
      <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
    </a>
  </div>
</div>
