---
import companyInfo from '../../data/companyInfo.json';
import { ShieldCheck, Phone, Clock } from '@lucide/astro';
---

<div class="bg-bsl-darkgreen text-white text-xs py-2 px-4 border-b border-emerald-900/40">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
    <!-- Left: Institution Tagline -->
    <div class="flex items-center flex-wrap justify-center sm:justify-start gap-x-4 gap-y-1">
      <span class="inline-flex items-center gap-1.5 text-emerald-200 font-medium">
        <ShieldCheck class="w-3.5 h-3.5 text-bsl-gold" />
        A Premier Mutual Benefit Financial Institution
      </span>
    </div>

    <!-- Right: Working Hours & Phone -->
    <div class="flex items-center gap-4 text-emerald-100">
      <span class="hidden lg:inline-flex items-center gap-1 text-emerald-300/90">
        <Clock class="w-3.5 h-3.5 text-bsl-gold" />
        {companyInfo.workingHours}
      </span>
      <a
        href={`tel:${companyInfo.phoneRaw}`}
        class="inline-flex items-center gap-1.5 font-semibold text-white hover:text-bsl-gold transition-colors bg-emerald-900/50 hover:bg-emerald-900 px-2.5 py-0.5 rounded-full border border-emerald-700/50"
      >
        <Phone class="w-3 h-3 text-bsl-gold" />
        <span>{companyInfo.phone}</span>
      </a>
    </div>
  </div>
</div>
